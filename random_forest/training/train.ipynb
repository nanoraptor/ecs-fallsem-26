import pickle
import sys
from pathlib import Path
import numpy as np
import pandas as pd

repo_root = Path.cwd().resolve()
for candidate in [repo_root, repo_root.parent, repo_root.parent.parent]:
    if (candidate / "random_forest" / "ebm_model.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from random_forest.ebm_model import AgronomicEBMClassifier, FEATURE_NAMES

df = pd.read_csv(
    "dataset/Crop_recommendation.csv"
    if Path("dataset/Crop_recommendation.csv").exists()
    else "random_forest/dataset/Crop_recommendation.csv"
).dropna(axis=1, how="all")

X = df[FEATURE_NAMES]
y = df["label"]

rng = np.random.RandomState(42)
idx = rng.permutation(len(df))
split = int(len(df) * 0.8)
train_idx, test_idx = idx[:split], idx[split:]

model = AgronomicEBMClassifier(random_state=42)
model.fit(X.iloc[train_idx], y.iloc[train_idx])
print(f"Validation Accuracy: {model.score(X.iloc[test_idx], y.iloc[test_idx]) * 100:.2f}%")

model.fit(X, y)
with open("soil_model.pkl", "wb") as fh:
    pickle.dump(model, fh, protocol=4)

print("Model trained and saved as soil_model.pkl")
